# Operator reference. ASP.NET Core does not automatically read .env files.
# Import the reviewed values through your host/service environment or secret store.
# Replace every YOUR_/REPLACE_ placeholder before starting the backend.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8080
AllowedHosts=YOUR_PUBLIC_HOSTNAME
ConnectionStrings__DefaultConnection="Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=False"
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Jwt__Issuer=YOUR_JWT_ISSUER
Jwt__Audience=YOUR_JWT_AUDIENCE
Jwt__ExpiryInDays=45
Otp__HashingKey=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
Otp__ExpiryMinutes=5
Otp__ResendCooldownSeconds=60
Otp__MaxSendRequests=30
Otp__SendWindowMinutes=15
Otp__MaxAttempts=5
Otp__VerificationWindowMinutes=15
Otp__IpSendPermitLimit=100
Otp__IpSendWindowMinutes=15
Otp__IpVerifyPermitLimit=100
Otp__IpVerifyWindowMinutes=5
Otp__ExposeForLocalTesting=false
# Development-only invitation previews. Configure the frontend signup destination locally.
# Invitation__SignupUrl=http://YOUR_LOCAL_FRONTEND_HOST:YOUR_PORT
Invitation__PreviewPermitLimit=5
Invitation__PreviewWindowMinutes=60
# Leave unset for same-origin deployment. For a separate HTTPS frontend, set index 0.
# Cors__AllowedOrigins__0=https://YOUR_FRONTEND_HOSTNAME
Swagger__Enabled=false
SignalR__KeepAliveInterval=00:00:15
SignalR__ClientTimeoutInterval=00:00:30
SignalR__HandshakeTimeout=00:00:15
SignalR__MaximumReceiveMessageSize=32768
SignalR__EnableDetailedErrors=false
