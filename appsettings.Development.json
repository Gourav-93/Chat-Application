{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Otp": {
    "ExpiryMinutes": 5,
    "MaxSendRequests": 30,
    "SendWindowMinutes": 15,
    "ResendCooldownSeconds": 5,
    "IpSendPermitLimit": 100,
    "IpSendWindowMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Swagger": {
    "Enabled": true
  }
}
