# Public build-time configuration. Replace the hostname for a separate API host.
# Leave both values empty when /api and /hubs/chat are hosted on the frontend origin.
VITE_API_BASE_URL=
VITE_SIGNALR_HUB_URL=
# Separate API example (VITE_API_BASE_URL is an origin, without /api)
# VITE_API_BASE_URL=https://YOUR_API_HOSTNAME
# VITE_SIGNALR_HUB_URL=https://YOUR_API_HOSTNAME/hubs/chat
